{
  "name": "codex-harness-desktop",
  "version": "0.0.31",
  "private": true,
  "description": "Independent desktop harness for OpenAI Codex",
  "main": "dist-electron/main.js",
  "scripts": {
    "accept": "node scripts/accept.mjs",
    "accept:list": "node scripts/accept.mjs --list",
    "build": "npm run build:electron && npm run build:vite",
    "build:electron": "node scripts/gen-rollout-worker.mjs && tsc -p electron/tsconfig.json",
    "build:vite": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 vite build",
    "check": "node scripts/clean-dist.mjs && npm run build && node scripts/verify-image-plugin.mjs && node scripts/verify-preload-args.mjs && node scripts/guards/11-knowledge-base.mjs && node scripts/guards/11b-kb-tools.mjs && node scripts/guards/11c-spinner.mjs && node scripts/guards/11d-office-screen.mjs && node scripts/guards/11e-topbar-popover.mjs && node scripts/guards/11f-dispatch-integrity.mjs && node scripts/guards/11g-dispatch-notice.mjs && node scripts/guards/11h-ui-sketch.mjs && node scripts/guards/11i-capability-gateway.mjs && node scripts/guards/11j-declared-plugins.mjs && node scripts/guards/11k-role-memory.mjs && node scripts/guards/11l-memory-fabric.mjs && node scripts/guards/11k-message-feedback.mjs && node scripts/guards/12-model-viewer.mjs && node scripts/verify-plan-editor.mjs && node scripts/check-preflight.mjs && node scripts/check-bag-types.mjs && node scripts/check-dead-imports.mjs && node scripts/check-require-paths.mjs",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "npm run build && electron-builder --win nsis",
    "dump-config": "node scripts/gen-domain-registry.mjs --dump-config",
    "e2e": "node scripts/accept.mjs",
    "e2e:list": "node scripts/accept.mjs --list",
    "engine:upgrade": "node scripts/upgrade-codex-engine.cjs",
    "engine:verify": "node scripts/upgrade-codex-engine.cjs --verify-only",
    "gen:domains": "node scripts/gen-domain-registry.mjs",
    "gen:domains:minimal": "node scripts/gen-domain-registry.mjs --profile=minimal",
    "gen:ipc": "node scripts/gen-ipc-bridge.mjs generate && node scripts/gen-capability-skill.mjs",
    "lint": "eslint .",
    "prebuild": "tsc -b",
    "preview:fresh": "node scripts/preview-fresh.mjs",
    "scan:config": "node scripts/scan-config.mjs",
    "start": "electron .",
    "verify": "npm run check && npm run accept",
    "verify:image-plugin": "node scripts/verify-image-plugin.mjs",
    "verify:packaged-tools": "node scripts/verify-packaged-tools.cjs",
    "verify:reasoning": "node scripts/verify-reasoning-transport.cjs",
    "voice:models": "node scripts/install-voice-models.cjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@larksuiteoapi/node-sdk": "^1.73.3",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@openai/codex": "^0.153.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "dingtalk-stream": "^2.1.6-beta.1",
    "katex": "^0.18.9",
    "koffi": "^3.3.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "pixi.js": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sherpa-onnx-node": "^1.13.8",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.codexharness.desktop",
    "productName": "Codex Harness Desktop",
    "npmRebuild": false,
    "beforePack": "scripts/before-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "src/lib/*.mjs",
      "!dist-electron/**/*.tsbuildinfo",
      "build/tray.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json",
      "!node_modules/mermaid/dist/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/tools/node",
        "to": "tools/node"
      },
      {
        "from": "resources/tools/pwsh-headless",
        "to": "tools/pwsh-headless"
      },
      {
        "from": "resources/tools/vscode-cli",
        "to": "tools/vscode-cli"
      },
      {
        "from": "resources/tools/cloudflared.exe",
        "to": "tools/cloudflared.exe"
      },
      {
        "from": "resources/tools/nuphus-call.mjs",
        "to": "tools/nuphus-call.mjs"
      },
      {
        "from": "resources/tools/harness-uia.mjs",
        "to": "tools/harness-uia.mjs"
      },
      {
        "from": "resources/tools/desktop-uia.ps1",
        "to": "tools/desktop-uia.ps1"
      },
      {
        "from": "resources/tools/harness-media.mjs",
        "to": "tools/harness-media.mjs"
      },
      {
        "from": "resources/tools/harness-video.mjs",
        "to": "tools/harness-video.mjs"
      },
      {
        "from": "src/lib/video-providers.mjs",
        "to": "tools/video-providers.mjs"
      },
      {
        "from": "resources/tools/cloak-open.mjs",
        "to": "tools/cloak-open.mjs"
      },
      {
        "from": "resources/tools/python",
        "to": "tools/python"
      },
      {
        "from": "resources/tools/rg",
        "to": "tools/rg"
      },
      {
        "from": "resources/tools/uv",
        "to": "tools/uv"
      },
      {
        "from": "resources/tools/jq",
        "to": "tools/jq"
      },
      {
        "from": "resources/tools/ninja",
        "to": "tools/ninja"
      },
      {
        "from": "resources/tools/sevenzip",
        "to": "tools/sevenzip"
      },
      {
        "from": "resources/tools/yt-dlp",
        "to": "tools/yt-dlp"
      },
      {
        "from": "resources/tools/cmake",
        "to": "tools/cmake"
      },
      {
        "from": "resources/tools/platform-tools",
        "to": "tools/platform-tools"
      },
      {
        "from": "resources/tools/automation-tools.zip",
        "to": "tools/automation-tools.zip"
      },
      {
        "from": "resources/tools/npm-global",
        "to": "tools/npm-global",
        "filter": [
          "**/*",
          "!node_modules",
          "!node_modules/**/*",
          "!cloakbrowser",
          "!cloakbrowser.cmd",
          "!cloakbrowser.ps1"
        ]
      },
      {
        "from": "resources/tools/npm-global/node_modules",
        "to": "tools/npm-global/node_modules",
        "filter": [
          "**/*",
          "!cloakbrowser",
          "!cloakbrowser/**/*",
          "!.bin/cloakbrowser",
          "!.bin/cloakbrowser.cmd",
          "!.bin/cloakbrowser.ps1"
        ]
      },
      {
        "from": "scripts/install-runtimes.cjs",
        "to": "tools/install-runtimes.cjs"
      },
      {
        "from": "scripts/install-automation.cjs",
        "to": "tools/install-automation.cjs"
      },
      {
        "from": "scripts/install-memory-mcp.cjs",
        "to": "tools/install-memory-mcp.cjs"
      },
      {
        "from": "resources/tools/ponytail-plugin",
        "to": "tools/ponytail-plugin"
      },
      {
        "from": "resources/voice-presets",
        "to": "voice-presets"
      },
      {
        "from": "resources/expert-skills",
        "to": "expert-skills"
      }
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-*/vendor/**",
      "node_modules/@lydell/node-pty/**",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
