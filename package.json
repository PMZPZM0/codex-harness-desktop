{
  "name": "codex-harness-desktop",
  "version": "0.0.8",
  "private": true,
  "description": "Independent desktop harness for OpenAI Codex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "prebuild": "tsc -b",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:vite": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 vite build",
    "build": "npm run build:electron && npm run build:vite",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:conversation": "node scripts/verify-conversation.mjs",
    "verify:channel": "node scripts/verify-channel-bot.mjs",
    "verify:services": "node scripts/verify-harness-services.mjs",
    "verify:turnfold": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 node scripts/verify-turn-fold.mjs",
    "verify:sessions": "node scripts/verify-session-tools.mjs",
    "verify:userrefs": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 node scripts/verify-user-refs.mjs",
    "verify:memory-layers": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 node scripts/verify-memory-layers.mjs",
    "verify:thread-backup": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 node scripts/verify-thread-backup.mjs",
    "verify:skill-icon": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 node scripts/verify-skill-icon.mjs",
    "verify:prompt-images": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 node scripts/verify-prompt-images.mjs",
    "verify:capability-groups": "node --experimental-strip-types scripts/verify-capability-groups.mjs",
    "verify:focus-return": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 node scripts/verify-focus-return.mjs",
    "verify:watchdog": "node scripts/check-watchdog.cjs",
    "verify:path-extractor": "node scripts/verify-file-path-extractor.mjs",
    "verify:lifecycle": "node scripts/check-lifecycle.cjs && node scripts/check-engine-cleanup.cjs",
    "engine:upgrade": "node scripts/upgrade-codex-engine.cjs",
    "engine:verify": "node scripts/upgrade-codex-engine.cjs --verify-only",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@openai/codex": "^0.153.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.codexharness.desktop",
    "productName": "Codex Harness Desktop",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/**/*.tsbuildinfo",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tools/node",
        "to": "tools/node"
      },
      {
        "from": "resources/tools/pwsh",
        "to": "tools/pwsh"
      },
      {
        "from": "resources/tools/pwsh-headless",
        "to": "tools/pwsh-headless"
      },
      {
        "from": "resources/tools/git",
        "to": "tools/git"
      },
      {
        "from": "resources/tools/python",
        "to": "tools/python"
      },
      {
        "from": "resources/tools/vscode-cli",
        "to": "tools/vscode-cli"
      },
      {
        "from": "resources/tools/rg",
        "to": "tools/rg"
      },
      {
        "from": "resources/tools/uv",
        "to": "tools/uv"
      },
      {
        "from": "resources/tools/cmake",
        "to": "tools/cmake"
      },
      {
        "from": "resources/tools/ninja",
        "to": "tools/ninja"
      },
      {
        "from": "resources/tools/sevenzip",
        "to": "tools/sevenzip"
      },
      {
        "from": "resources/tools/jq",
        "to": "tools/jq"
      },
      {
        "from": "resources/tools/cloudflared.exe",
        "to": "tools/cloudflared.exe"
      },
      {
        "from": "resources/tools/nuphus-call.mjs",
        "to": "tools/nuphus-call.mjs"
      },
      {
        "from": "resources/tools/cloak-open.mjs",
        "to": "tools/cloak-open.mjs"
      },
      {
        "from": "resources/tools/automation-tools.zip",
        "to": "tools/automation-tools.zip"
      },
      {
        "from": "scripts/install-runtimes.cjs",
        "to": "tools/install-runtimes.cjs"
      },
      {
        "from": "scripts/install-automation.cjs",
        "to": "tools/install-automation.cjs"
      },
      {
        "from": "resources/tools/ponytail-plugin",
        "to": "tools/ponytail-plugin"
      }
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-*/vendor/**",
      "node_modules/@lydell/node-pty/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
