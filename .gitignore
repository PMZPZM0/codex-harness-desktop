# 依赖
node_modules/

# 构建产物
dist/
dist-electron/
release/
release-*/
# 发布站源码纳入版本控制（.env 与数据文件由 release-site/.gitignore 排除）
!release-site/
*.tsbuildinfo

# 会话数据导出备份（引擎原档 jsonl/整包，含本机对话内容，不纳入 git）
thread-backup-*/
.release-site-work/

# 日志
*.log
electron-log.txt

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 本地环境变量
.env
.env.local
.env.*.local

# 测试运行时产物（验证脚本每次运行会重新生成带编号的目录）
.verify-*/
.test-data/
.test-tmp/
terminal-dump.txt

# E2E 运行产物（截图 / 报告，每次跑都会重新生成）
.e2e-artifacts/
# E2E 增量验收状态（记录每个场景已按哪份内容验收过，本机文件不入库）
.e2e-state.json
# E2E 持久测试 profile（跨轮次保留会话历史/长会话，含真实 Key 密文与本机对话内容）
.e2e-profile/

# 工具数据
.workbuddy/

# 应用生成的本机数据（引擎项目级记忆目录 / 浏览器自动化运行时产物，不纳入 git）
.codex-harness/
.playwright-cli/

# 并行构建流程的临时产物
dist-new/

# 大体积二进制运行时（不纳入 git，首次启动由 install-runtimes.cjs 按需下载）
resources/tools/*
!resources/tools/harness-media.mjs
# pwsh 无窗口桥的编译源码（产物 pwsh.exe 由 CI 在 runner 上现编，见 scripts/prepare-windows-tools.cjs）
!resources/tools/pwsh-headless/
resources/tools/pwsh-headless/*
!resources/tools/pwsh-headless/PwshHeadless.cs

# 本地留存的已发布安装包（数百 MB 二进制，发布站/GitHub 才是权威分发处）
installers-archive/

# 第三方应用逆向解包产物（分析用，2 万+ 文件 / 数百 MB，绝不入库）
.dsh-probe/

# 调试/一次性产物（本机排查用，不属于源码）
diag-*.mjs
diag-*.py
find-cmds*.cjs
extract-commands.cjs
a1.txt
s-*.png
crash-*.log
app-std*.log
output/
tmp/
scripts/diag-*
scripts/_patch_*
scripts/_verify-fix.js
scripts/tmp-*
scripts/shot-readme.mjs
archive/

# 一次性临时脚本（含本机绝对路径，不纳入 git）
scripts/tmp-fix-shortcut.cjs
cdp-check.mjs

# 构建期生成物：rollout worker 源码内联（由 scripts/gen-rollout-worker.mjs 从
# electron/rollout-worker.cjs 生成，改源文件即可，产物不入库）
electron/rollout-worker-source.ts

# 开发模式工作区（独立 git 仓，不进应用根仓——stash -u/reset 才不会波及它）

# 编辑器/调试残留，不入库
*.bak
*.pre-mermaid.bak
__perm_test.txt
mermaid-e2e-test.html

# 运行时溢出到仓库根的产物（不是源码，一直在 git status 里当噪音）
#   .tmp/         —— 调试用例落盘的截图/探针输出
#   images/       —— 生图/视觉插件落盘的图片（内含 .dsh-image-sync.json 同步标记）
#   .workbuddy-ai/ —— AI 助手的工作记忆目录
.tmp/
images/
.workbuddy-ai/

# 编辑器/工具批量操作残留的临时合并文件（09-14 实测 7439 个 SVG 临时文件塞满项目根）
.merge_file_*
