#!/bin/sh
# Harness shim: run qwenpaw through harness-qwenpaw.py (headless tools fix).
# Kept in tools/cli-shims and placed before python/bin in PATH.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for PY in "$DIR/../python/bin/python3" "python3"; do
  [ -n "$PY" ] || continue
  if [ -x "$PY" ] || command -v "$PY" >/dev/null 2>&1; then
    if "$PY" -c "import qwenpaw" >/dev/null 2>&1; then
      exec "$PY" "$DIR/../harness-qwenpaw.py" "$@"
    fi
  fi
done
echo "qwenpaw is not installed for any known Python." >&2
exit 127
