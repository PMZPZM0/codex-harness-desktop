# 复制为 .env 后修改
# 生产注意：124.220.63.4 的 8080 已被 docker「经营罗盘」占用，release-site 生产端口请避开（如 8090）
PORT=8090
# 管理员登录密码（首次启动后请立刻改）
ADMIN_PASSWORD=admin123
# 管理员账号名（前端写死 admin）
ADMIN_USER=admin
# 公开站点标题
SITE_TITLE=Codex Harness · 版本发布中心
# 当前桌面端官方主版本（仅显示用，不参与更新判断）
CURRENT_LATEST_TAG=v0.4.1
# 数据目录（相对 release-site/）
DATA_DIR=./data
# 默认 release channel
DEFAULT_CHANNEL=stable
# 静态资源目录
PUBLIC_DIR=./public